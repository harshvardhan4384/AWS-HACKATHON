# Environment variables example for Re:COVER Backend
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# PostgreSQL connection string (PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5432/recover"

# Session configuration
SESSION_COOKIE_NAME=recover_session
SESSION_TTL_DAYS=7

# OAuth token encryption key (AES-256-GCM 32-byte / 64-hex string)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OAUTH_STATE_TTL_MINUTES=10

# Google OAuth 2.0 Web Application Credentials
# Obtain from Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/oauth/google/callback

# GitHub OAuth App Credentials
# Obtain from GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/oauth/github/callback

# Neo4j Identity / Attack Graph Configuration (Task 11)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME_MS=3600000
NEO4J_CONNECTION_TIMEOUT_MS=5000

# Blast Radius Engine Configuration (Task 12)
BLAST_RADIUS_MAX_DEPTH=5
BLAST_RADIUS_MAX_NODES=500
BLAST_RADIUS_MAX_PATHS=100
BLAST_RADIUS_TIMEOUT_MS=10000

# Recovery Planner + Action Executor Configuration (Task 13)
RECOVERY_MAX_ACTIONS_PER_PLAN=10
RECOVERY_MAX_EXECUTION_TIME_MS=30000
RECOVERY_AUTHORIZATION_TTL_MINUTES=60

# Policy + Approval Engine Configuration (Task 14)
POLICY_VERSION=v1
APPROVAL_EXPIRY_MINUTES=30

# Verification & Persistence Engine Configuration (Task 15)
VERIFICATION_TIMEOUT_MS=10000
VERIFICATION_EVENT_WINDOW_MINUTES=30
MAX_VERIFICATION_CHECKS=50
MAX_POST_RECOVERY_EVENTS=100
MAX_PERSISTENCE_ITEMS=100
MAX_RECOVERY_CYCLES_PER_INCIDENT=3

# Notifications + WebSockets Configuration (Task 16)
WS_HEARTBEAT_INTERVAL_MS=30000
WS_CONNECTION_TIMEOUT_MS=10000
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_TOTAL_CONNECTIONS=1000
WS_MAX_MESSAGES_PER_MINUTE=120
WS_MAX_MESSAGE_BYTES=16384
MAX_NOTIFICATION_PAYLOAD_BYTES=16384
NOTIFICATION_RETENTION_DAYS=30
MAX_NOTIFICATION_PAGE_SIZE=100




