# ==============================================================================
# Re:COVER Backend — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your deployment.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# ── Server & Environment ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ── PostgreSQL Database (Prisma >= 15 / Prisma 8 RC) ──────────────────────────
# Required: Connection string for PostgreSQL database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/recover

# ── Session Management ────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=recover_session
SESSION_TTL_DAYS=7

# ── Security & Token Encryption ───────────────────────────────────────────────
# AES-256-GCM 32-byte (64-character) hex encryption key for OAuth tokens & 2FA secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-64-character-hex-encryption-key
OAUTH_STATE_TTL_MINUTES=10

# ── Google OAuth 2.0 (Connected Accounts) ─────────────────────────────────────
# Obtain from Google Cloud Console: APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/oauth/google/callback

# ── GitHub OAuth 2.0 (Connected Accounts) ─────────────────────────────────────
# Obtain from GitHub: Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/oauth/github/callback

# ── Detection Engine (Deterministic Rules) ─────────────────────────────────────
DETECTION_UNFAMILIAR_LOGIN_LOOKBACK_DAYS=30
DETECTION_RAPID_CREDENTIAL_WINDOW_MINUTES=10
DETECTION_TAKEOVER_WINDOW_MINUTES=30
DETECTION_CROSS_ACCOUNT_WINDOW_MINUTES=30
RISK_SCORE_MAX=100

# ── AWS Bedrock & AI Investigation Engine (Task 10) ───────────────────────────
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.1
BEDROCK_TIMEOUT_MS=30000
AI_MAX_TOOL_CALLS=10
AI_MAX_GRAPH_STEPS=20
AI_MAX_INVESTIGATION_TIME_MS=60000
AI_MAX_TOOL_RESULT_ITEMS=100
# Optional: Set to true to mock AWS Bedrock during offline/local testing
AI_MOCK_BEDROCK=false
# Optional: AWS IAM credentials for Bedrock (if not using AWS instance profile / IAM role)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ── Neo4j Identity / Attack Graph (Task 11) ───────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME_MS=3600000
NEO4J_CONNECTION_TIMEOUT_MS=5000

# ── Blast Radius Engine (Task 12) ─────────────────────────────────────────────
BLAST_RADIUS_MAX_DEPTH=5
BLAST_RADIUS_MAX_NODES=500
BLAST_RADIUS_MAX_PATHS=100
BLAST_RADIUS_TIMEOUT_MS=10000

# ── Recovery Planner & Action Executor (Task 13) ──────────────────────────────
RECOVERY_MAX_ACTIONS_PER_PLAN=10
RECOVERY_MAX_EXECUTION_TIME_MS=30000
RECOVERY_AUTHORIZATION_TTL_MINUTES=60

# ── Policy & Approval Engine (Task 14) ────────────────────────────────────────
POLICY_VERSION=v1
APPROVAL_EXPIRY_MINUTES=30

# ── Verification & Persistence Engine (Task 15) ───────────────────────────────
VERIFICATION_TIMEOUT_MS=10000
VERIFICATION_EVENT_WINDOW_MINUTES=30
MAX_VERIFICATION_CHECKS=50
MAX_POST_RECOVERY_EVENTS=100
MAX_PERSISTENCE_ITEMS=100
MAX_RECOVERY_CYCLES_PER_INCIDENT=3

# ── Real-Time WebSockets & Notifications (Task 16) ────────────────────────────
WS_HEARTBEAT_INTERVAL_MS=30000
WS_CONNECTION_TIMEOUT_MS=10000
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_TOTAL_CONNECTIONS=1000
WS_MAX_MESSAGES_PER_MINUTE=120
WS_MAX_MESSAGE_BYTES=16384
MAX_NOTIFICATION_PAYLOAD_BYTES=16384
NOTIFICATION_RETENTION_DAYS=30
MAX_NOTIFICATION_PAGE_SIZE=100

# ── SMTP Email Service (Account Security: OTP & Notifications) ────────────────
# Backend-only — NEVER expose to client or prefix with VITE_
SMTP_HOST=your-smtp-host.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Re:COVER Security <no-reply@recover.security>"
SMTP_SECURE=false

# ── OTP & TOTP 2FA Engine ─────────────────────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
PENDING_2FA_TTL_MINUTES=5
